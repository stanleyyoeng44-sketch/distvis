{
  "id": "partition",
  "name": "RA partition: no replay after healing",
  "settings": {
    "nodeCount": 3,
    "latency": 80
  },
  "steps": [
    {
      "fault": {
        "kind": "link",
        "from": "node-1",
        "to": "node-3",
        "blocked": true,
        "bidirectional": true
      }
    },
    {
      "input": {
        "node": "node-1",
        "method": "Application.Acquire",
        "values": {
          "holdMs": 200
        }
      },
      "expect": "ok"
    },
    {
      "wait": 4000
    },
    {
      "check": {
        "node": "node-1",
        "path": "entries",
        "op": "==",
        "value": 0
      }
    },
    {
      "fault": {
        "kind": "heal"
      }
    },
    {
      "wait": 2000
    },
    {
      "check": {
        "node": "node-1",
        "path": "entries",
        "op": "==",
        "value": 0
      }
    },
    {
      "check": {
        "atMostOne": {
          "path": "role",
          "value": "critical"
        }
      },
      "label": "No overlapping critical sections in reported history"
    }
  ]
}
