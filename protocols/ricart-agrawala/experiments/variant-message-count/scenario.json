{
  "id": "variant-message-count",
  "name": "RA design: four messages, no Release",
  "settings": {
    "nodeCount": 3,
    "latency": 80
  },
  "steps": [
    {
      "input": {
        "node": "node-1",
        "method": "Application.Acquire",
        "values": {
          "holdMs": 200
        }
      },
      "expect": "ok"
    },
    {
      "until": {
        "node": "node-1",
        "path": "completed",
        "op": "==",
        "value": 1
      },
      "timeout": 20000
    },
    {
      "check": {
        "messages": {
          "method": "MutexService.Request",
          "op": "==",
          "value": 2
        }
      }
    },
    {
      "check": {
        "messages": {
          "method": "MutexService.Ack",
          "op": "==",
          "value": 2
        }
      }
    },
    {
      "check": {
        "messages": {
          "method": "MutexService.Release",
          "op": "==",
          "value": 0
        }
      }
    },
    {
      "check": {
        "atMostOne": {
          "path": "role",
          "value": "critical"
        }
      },
      "label": "No overlapping critical sections in reported history"
    }
  ]
}
