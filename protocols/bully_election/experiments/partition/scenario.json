{
  "id": "partition",
  "name": "Bully partition: two component coordinators",
  "settings": {
    "nodeCount": 5,
    "latency": 80
  },
  "steps": [
    {
      "until": {
        "node": "*",
        "path": "coordinator",
        "op": "==",
        "value": "node-5"
      },
      "timeout": 20000
    },
    {
      "fault": {
        "kind": "link",
        "from": "node-1",
        "to": "node-3",
        "blocked": true,
        "bidirectional": true
      }
    },
    {
      "fault": {
        "kind": "link",
        "from": "node-1",
        "to": "node-4",
        "blocked": true,
        "bidirectional": true
      }
    },
    {
      "fault": {
        "kind": "link",
        "from": "node-1",
        "to": "node-5",
        "blocked": true,
        "bidirectional": true
      }
    },
    {
      "fault": {
        "kind": "link",
        "from": "node-2",
        "to": "node-3",
        "blocked": true,
        "bidirectional": true
      }
    },
    {
      "fault": {
        "kind": "link",
        "from": "node-2",
        "to": "node-4",
        "blocked": true,
        "bidirectional": true
      }
    },
    {
      "fault": {
        "kind": "link",
        "from": "node-2",
        "to": "node-5",
        "blocked": true,
        "bidirectional": true
      }
    },
    {
      "until": {
        "node": "node-2",
        "path": "coordinator",
        "op": "==",
        "value": "node-2"
      },
      "timeout": 25000
    },
    {
      "check": {
        "node": "node-5",
        "path": "coordinator",
        "op": "==",
        "value": "node-5"
      }
    },
    {
      "fault": {
        "kind": "heal"
      }
    },
    {
      "input": {
        "node": "node-1",
        "method": "Application.StartElection",
        "values": {}
      },
      "expect": "ok"
    },
    {
      "until": {
        "node": "*",
        "path": "coordinator",
        "op": "==",
        "value": "node-5"
      },
      "timeout": 20000
    }
  ]
}
