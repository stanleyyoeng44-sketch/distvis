{
  "id": "two-crashes",
  "name": "Bully: two highest nodes crash",
  "settings": {
    "nodeCount": 7,
    "latency": 80
  },
  "steps": [
    {
      "until": {
        "node": "*",
        "path": "coordinator",
        "op": "==",
        "value": "node-7"
      },
      "timeout": 20000
    },
    {
      "fault": {
        "kind": "crash",
        "node": "node-7"
      }
    },
    {
      "fault": {
        "kind": "crash",
        "node": "node-6"
      }
    },
    {
      "until": {
        "node": "*",
        "path": "coordinator",
        "op": "==",
        "value": "node-5"
      },
      "timeout": 25000
    }
  ]
}
