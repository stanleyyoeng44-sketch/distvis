{
  "id": "crash",
  "name": "Lamport B - idle peer crash",
  "settings": {
    "runtime": "docker",
    "nodeCount": 3,
    "latency": 80,
    "bandwidth": 128,
    "seed": 42
  },
  "steps": [
    {
      "fault": {
        "kind": "crash",
        "node": "node-3"
      }
    },
    {
      "input": {
        "node": "node-2",
        "method": "Application.Acquire",
        "values": {
          "holdMs": 2000
        }
      },
      "expect": "ok"
    },
    {
      "until": {
        "node": "node-2",
        "path": "lastError",
        "op": "includes",
        "value": "node-3"
      }
    },
    {
      "wait": 11000
    },
    {
      "check": {
        "all": [
          {
            "node": "node-2",
            "path": "operation",
            "value": "waiting"
          },
          {
            "node": "node-2",
            "path": "entries",
            "value": 0
          },
          {
            "node": "node-2",
            "path": "missingAcks",
            "value": [
              "node-3"
            ]
          }
        ]
      }
    },
    {
      "check": {
        "atMostOne": {
          "path": "role",
          "value": "critical"
        }
      }
    }
  ]
}
