        },
        {
          "until": {
            "node": "node-1",
            "path": "decision",
            "op": "==",
            "value": "commit"
          },
          "timeout": 20000
        },
        {
          "fault": {
            "kind": "crash",
            "node": "node-2"
          }
        },
        {
          "fault": {
            "kind": "recover",
            "node": "node-2"
          }
        },
        {
          "wait": 2000
        },
        {
          "until": {
            "node": "node-1",
            "path": "phase",
            "op": "==",
            "value": "finished"
          },
          "timeout": 20000
        },
        {
          "check": {
            "node": "node-2",
            "path": "balance",
            "op": "==",
            "value": 70
          }
        },
        {
          "check": {
            "node": "node-3",
            "path": "balance",
            "op": "==",
            "value": 130
          }
        }
      ]
    }
  ]
}
