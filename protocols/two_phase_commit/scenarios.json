{
  "scenarios": [
    {
      "id": "normal-two-transfers",
      "name": "2PC normal: two transfers conserve 200",
      "settings": {
        "nodeCount": 3,
        "latency": 80
      },
      "steps": [
        {
          "input": {
            "node": "node-1",
            "method": "Application.Transfer",
            "values": {
              "from": "node-2",
              "to": "node-3",
              "amount": 30
            }
          },
          "expect": "ok"
        },
        {
          "until": {
            "node": "node-1",
            "path": "phase",
            "op": "==",
            "value": "finished"
          },
          "timeout": 20000
        },
        {
          "check": {
            "node": "node-2",
            "path": "balance",
            "op": "==",
            "value": 70
          }
        },
        {
          "check": {
            "node": "node-3",
            "path": "balance",
            "op": "==",
            "value": 130
          }
        },
        {
          "input": {
            "node": "node-1",
            "method": "Application.Transfer",
            "values": {
              "from": "node-2",
              "to": "node-3",
              "amount": 30
            }
          },
          "expect": "ok"
        },
        {
          "until": {
            "node": "node-1",
            "path": "phase",
            "op": "==",
            "value": "finished"
          },
          "timeout": 20000
        },
        {
          "check": {
            "node": "node-2",
            "path": "balance",
            "op": "==",
            "value": 40
          }
        },
        {
          "check": {
            "node": "node-3",
            "path": "balance",
            "op": "==",
            "value": 160
          }
        }
      ]
    },
    {
      "id": "veto",
      "name": "2PC: insufficient balance veto",
      "settings": {
        "nodeCount": 3,
        "latency": 80
      },
      "steps": [
        {
          "input": {
            "node": "node-1",
            "method": "Application.Transfer",
            "values": {
              "from": "node-2",
              "to": "node-3",
              "amount": 150
            }
          },
          "expect": "ok"
        },
        {
          "until": {
            "node": "node-1",
            "path": "phase",
            "op": "==",
            "value": "finished"
          },
          "timeout": 20000
        },
        {
          "check": {
            "node": "node-1",
            "path": "decision",
            "op": "==",
            "value": "abort"
          }
        },
        {
          "check": {
            "node": "node-2",
            "path": "balance",
            "op": "==",
            "value": 100
          }
        },
        {
          "check": {
            "node": "node-3",
            "path": "balance",
            "op": "==",
            "value": 100
          }
        },
        {
          "check": {
            "node": "node-3",
            "path": "state",
            "op": "==",
            "value": "aborted"
          }
        }
      ]
    },
    {
      "id": "crash-before-decision",
      "name": "2PC crash: before durable decision aborts",
      "settings": {
        "nodeCount": 3,
        "latency": 80
      },
      "steps": [
        {
          "input": {
            "node": "node-1",
            "method": "Application.Transfer",
            "values": {
              "from": "node-2",
              "to": "node-3",
              "amount": 30,
              "pauseBeforeDecisionMs": 30000
            }
          },
          "expect": "ok"
        },
        {
          "until": {
            "node": "node-1",
            "path": "votes.node-3",
            "op": "==",
            "value": "yes"
          },
          "timeout": 20000
        },
        {
          "fault": {
            "kind": "crash",
            "node": "node-1"
          }
        },
        {
          "until": {
            "node": "node-2",
            "path": "state",
            "op": "==",
            "value": "uncertain"
          },
          "timeout": 20000
        },
        {
          "fault": {
            "kind": "recover",
            "node": "node-1"
          }
        },
        {
          "wait": 2000
        },
        {
          "until": {
            "node": "node-1",
            "path": "phase",
            "op": "==",
            "value": "finished"
          },
          "timeout": 20000
        },
        {
          "check": {
            "node": "node-1",
            "path": "decision",
            "op": "==",
            "value": "abort"
          }
        },
        {
          "check": {
            "node": "node-2",
            "path": "balance",
            "op": "==",
            "value": 100
          }
        },
        {
          "check": {
            "node": "node-3",
            "path": "balance",
            "op": "==",
            "value": 100
          }
        }
      ]
    },
    {
      "id": "crash-after-decision",
      "name": "2PC crash: durable commit completes",
      "settings": {
        "nodeCount": 3,
        "latency": 80
      },
      "steps": [
        {
          "input": {
            "node": "node-1",
            "method": "Application.Transfer",
            "values": {
              "from": "node-2",
              "to": "node-3",
              "amount": 30,
              "pauseAfterDecisionMs": 30000
            }
          },
          "expect": "ok"
        },
        {
          "until": {
            "node": "node-1",
            "path": "decision",
            "op": "==",
            "value": "commit"
          },
          "timeout": 20000
        },
        {
          "fault": {
            "kind": "crash",
            "node": "node-1"
          }
        },
        {
          "until": {
            "node": "node-2",
            "path": "state",
            "op": "==",
            "value": "uncertain"
          },
          "timeout": 20000
        },
        {
          "check": {
            "node": "node-2",
            "path": "balance",
            "op": "==",
            "value": 100
          }
        },
        {
          "fault": {
            "kind": "recover",
            "node": "node-1"
          }
        },
        {
          "wait": 2000
        },
        {
          "until": {
            "node": "node-1",
            "path": "phase",
            "op": "==",
            "value": "finished"
          },
          "timeout": 20000
        },
        {
          "check": {
            "node": "node-2",
            "path": "balance",
            "op": "==",
            "value": 70
          }
        },
        {
          "check": {
            "node": "node-3",
            "path": "balance",
            "op": "==",
            "value": 130
          }
        }
      ]
    },
    {
      "id": "partition",
      "name": "2PC partition: notification retries after heal",
      "settings": {
        "nodeCount": 3,
        "latency": 80
      },
      "steps": [
        {
          "input": {
            "node": "node-1",
            "method": "Application.Transfer",
            "values": {
              "from": "node-2",
              "to": "node-3",
              "amount": 30,
              "pauseAfterDecisionMs": 2000
            }
          },
          "expect": "ok"
        },
        {
          "until": {
            "node": "node-1",
            "path": "decision",
            "op": "==",
            "value": "commit"
          },
          "timeout": 20000
        },
        {
          "fault": {
            "kind": "link",
            "from": "node-1",
            "to": "node-2",
            "blocked": true,
            "bidirectional": true
          }
        },
        {
          "until": {
            "node": "node-3",
            "path": "state",
            "op": "==",
            "value": "committed"
          },
          "timeout": 20000
        },
        {
          "until": {
            "node": "node-2",
            "path": "state",
            "op": "==",
            "value": "uncertain"
          },
          "timeout": 20000
        },
        {
          "check": {
            "node": "node-1",
            "path": "phase",
            "op": "==",
            "value": "decided"
          }
        },
        {
          "fault": {
            "kind": "heal"
          }
        },
        {
          "until": {
            "node": "node-1",
            "path": "phase",
            "op": "==",
            "value": "finished"
          },
          "timeout": 20000
        },
        {
          "check": {
            "node": "node-2",
            "path": "balance",
            "op": "==",
            "value": 70
          }
        }
      ]
    },
    {
      "id": "variant-no-prepare-log",
      "name": "2PC variant: YES without durable prepared record",
      "settings": {
        "nodeCount": 3,
        "latency": 80
      },
      "steps": [
        {
          "input": {
            "node": "node-2",
            "method": "Application.Variant",
            "values": {
              "skipPrepareSave": true
            }
          },
          "expect": "ok"
        },
        {
          "input": {
            "node": "node-1",
            "method": "Application.Transfer",
            "values": {
              "from": "node-2",
              "to": "node-3",
              "amount": 30,
              "pauseAfterDecisionMs": 4000
            }
          },
          "expect": "ok"
        },
        {
          "until": {
            "node": "node-1",
            "path": "decision",
            "op": "==",
            "value": "commit"
          },
          "timeout": 20000
        },
        {
          "fault": {
            "kind": "crash",
            "node": "node-2"
          }
        },
        {
          "fault": {
            "kind": "recover",
            "node": "node-2"
          }
        },
        {
          "wait": 2000
        },
        {
          "until": {
            "node": "node-3",
            "path": "state",
            "op": "==",
            "value": "committed"
          },
          "timeout": 20000
        },
        {
          "check": {
            "node": "node-2",
            "path": "balance",
            "op": "==",
            "value": 100
          }
        },
        {
          "check": {
            "node": "node-3",
            "path": "balance",
            "op": "==",
            "value": 130
          }
        },
        {
          "check": {
            "node": "node-1",
            "path": "phase",
            "op": "==",
            "value": "decided"
          }
        }
      ]
    },
    {
      "id": "participant-recovery-control",
