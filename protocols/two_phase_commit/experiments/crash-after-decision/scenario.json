{
  "id": "crash-after-decision",
  "name": "2PC crash: durable commit completes",
  "settings": {
    "nodeCount": 3,
    "latency": 80
  },
  "steps": [
    {
      "input": {
        "node": "node-1",
        "method": "Application.Transfer",
        "values": {
          "from": "node-2",
          "to": "node-3",
          "amount": 30,
          "pauseAfterDecisionMs": 30000
        }
      },
      "expect": "ok"
    },
    {
      "until": {
        "node": "node-1",
        "path": "decision",
        "op": "==",
        "value": "commit"
      },
      "timeout": 20000
    },
    {
      "fault": {
        "kind": "crash",
        "node": "node-1"
      }
    },
    {
      "until": {
        "node": "node-2",
        "path": "state",
        "op": "==",
        "value": "uncertain"
      },
      "timeout": 20000
    },
    {
      "check": {
        "node": "node-2",
        "path": "balance",
        "op": "==",
        "value": 100
      }
    },
    {
      "fault": {
        "kind": "recover",
        "node": "node-1"
      }
    },
    {
      "wait": 2000
    },
    {
      "until": {
        "node": "node-1",
        "path": "phase",
        "op": "==",
        "value": "finished"
      },
      "timeout": 20000
    },
    {
      "check": {
        "node": "node-2",
        "path": "balance",
        "op": "==",
        "value": 70
      }
    },
    {
      "check": {
        "node": "node-3",
        "path": "balance",
        "op": "==",
        "value": 130
      }
    }
  ]
}
