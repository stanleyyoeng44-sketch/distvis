{
  "id": "partition",
  "name": "2PC partition: notification retries after heal",
  "settings": {
    "nodeCount": 3,
    "latency": 80
  },
  "steps": [
    {
      "input": {
        "node": "node-1",
        "method": "Application.Transfer",
        "values": {
          "from": "node-2",
          "to": "node-3",
          "amount": 30,
          "pauseAfterDecisionMs": 2000
        }
      },
      "expect": "ok"
    },
    {
      "until": {
        "node": "node-1",
        "path": "decision",
        "op": "==",
        "value": "commit"
      },
      "timeout": 20000
    },
    {
      "fault": {
        "kind": "link",
        "from": "node-1",
        "to": "node-2",
        "blocked": true,
        "bidirectional": true
      }
    },
    {
      "until": {
        "node": "node-3",
        "path": "state",
        "op": "==",
        "value": "committed"
      },
      "timeout": 20000
    },
    {
      "until": {
        "node": "node-2",
        "path": "state",
        "op": "==",
        "value": "uncertain"
      },
      "timeout": 20000
    },
    {
      "check": {
        "node": "node-1",
        "path": "phase",
        "op": "==",
        "value": "decided"
      }
    },
    {
      "fault": {
        "kind": "heal"
      }
    },
    {
      "until": {
        "node": "node-1",
        "path": "phase",
        "op": "==",
        "value": "finished"
      },
      "timeout": 20000
    },
    {
      "check": {
        "node": "node-2",
        "path": "balance",
        "op": "==",
        "value": 70
      }
    }
  ]
}
