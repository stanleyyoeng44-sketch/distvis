{
  "id": "crash-catchup",
  "name": "Paxos KV crash: no-op hole recovery",
  "settings": {
    "nodeCount": 5,
    "latency": 80
  },
  "steps": [
    {
      "input": {
        "node": "node-1",
        "method": "Application.Put",
        "values": {
          "key": "x",
          "value": "1"
        }
      },
      "expect": "ok"
    },
    {
      "until": {
        "node": "*",
        "path": "applied",
        "op": "==",
        "value": 1
      },
      "timeout": 20000
    },
    {
      "fault": {
        "kind": "crash",
        "node": "node-5"
      }
    },
    {
      "input": {
        "node": "node-1",
        "method": "Application.Put",
        "values": {
          "key": "x",
          "value": "2"
        }
      },
      "expect": "ok"
    },
    {
      "input": {
        "node": "node-1",
        "method": "Application.Put",
        "values": {
          "key": "x",
          "value": "3"
        }
      },
      "expect": "ok"
    },
    {
      "input": {
        "node": "node-1",
        "method": "Application.Put",
        "values": {
          "key": "x",
          "value": "4"
        }
      },
      "expect": "ok"
    },
    {
      "fault": {
        "kind": "recover",
        "node": "node-5"
      }
    },
    {
      "wait": 2000
    },
    {
      "input": {
        "node": "node-1",
        "method": "Application.Put",
        "values": {
          "key": "y",
          "value": "5"
        }
      },
      "expect": "ok"
    },
    {
      "until": {
        "node": "node-5",
        "path": "applied",
        "op": "==",
        "value": 5
      },
      "timeout": 30000
    },
    {
      "check": {
        "node": "node-5",
        "path": "values.x",
        "op": "==",
        "value": "4"
      }
    }
  ]
}
