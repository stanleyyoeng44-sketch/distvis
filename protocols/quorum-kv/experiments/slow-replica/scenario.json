{
  "id": "slow-replica",
  "name": "Quorum: fastest majority versus all replicas",
  "settings": {
    "nodeCount": 5,
    "latency": 80
  },
  "steps": [
    {
      "fault": {
        "kind": "link",
        "from": "node-1",
        "to": "node-5",
        "latency": 3000
      }
    },
    {
      "input": {
        "node": "node-1",
        "method": "Application.Put",
        "values": {
          "key": "x",
          "value": "1"
        }
      },
      "expect": "ok"
    },
    {
      "check": {
        "node": "node-1",
        "path": "lastPut.waitedMs",
        "op": "<",
        "value": 2000
      }
    },
    {
      "input": {
        "node": "node-1",
        "method": "Application.Mode",
        "values": {
          "w": 5,
          "r": 3
        }
      },
      "expect": "ok"
    },
    {
      "input": {
        "node": "node-1",
        "method": "Application.Put",
        "values": {
          "key": "x",
          "value": "2"
        }
      },
      "expect": "ok"
    },
    {
      "check": {
        "node": "node-1",
        "path": "lastPut.waitedMs",
        "op": ">=",
        "value": 3000
      }
    }
  ]
}
