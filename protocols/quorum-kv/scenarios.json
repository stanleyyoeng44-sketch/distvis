{
  "scenarios": [
    {
      "id": "normal",
      "name": "Quorum normal: sequential write and read",
      "settings": {
        "nodeCount": 5,
        "latency": 80
      },
      "steps": [
        {
          "input": {
            "node": "node-1",
            "method": "Application.Put",
            "values": {
              "key": "x",
              "value": "1"
            }
          },
          "expect": "ok"
        },
        {
          "input": {
            "node": "node-3",
            "method": "Application.Get",
            "values": {
              "key": "x",
              "minCounter": 1
            }
          },
          "expect": "ok"
        },
        {
          "check": {
            "node": "node-3",
            "path": "lastGet.item.value",
            "op": "==",
            "value": "1"
          }
        },
        {
          "check": {
            "node": "node-3",
            "path": "lastGet.stale",
            "op": "==",
            "value": false
          }
        }
      ]
    },
    {
      "id": "slow-replica",
      "name": "Quorum: fastest majority versus all replicas",
      "settings": {
        "nodeCount": 5,
        "latency": 80
      },
      "steps": [
        {
          "fault": {
            "kind": "link",
            "from": "node-1",
            "to": "node-5",
            "latency": 3000
          }
        },
        {
          "input": {
            "node": "node-1",
            "method": "Application.Put",
            "values": {
              "key": "x",
              "value": "1"
            }
          },
          "expect": "ok"
        },
        {
          "check": {
            "node": "node-1",
            "path": "lastPut.waitedMs",
            "op": "<",
            "value": 2000
          }
        },
        {
          "input": {
            "node": "node-1",
            "method": "Application.Mode",
            "values": {
              "w": 5,
              "r": 3
            }
          },
          "expect": "ok"
        },
        {
          "input": {
            "node": "node-1",
            "method": "Application.Put",
            "values": {
              "key": "x",
              "value": "2"
            }
          },
          "expect": "ok"
        },
        {
          "check": {
            "node": "node-1",
            "path": "lastPut.waitedMs",
            "op": ">=",
            "value": 3000
          }
        }
      ]
    },
    {
      "id": "crash",
      "name": "Quorum crash: majority still available",
      "settings": {
        "nodeCount": 5,
        "latency": 80
      },
      "steps": [
        {
          "fault": {
            "kind": "crash",
            "node": "node-5"
          }
        },
        {
          "input": {
            "node": "node-1",
            "method": "Application.Put",
            "values": {
              "key": "x",
              "value": "1"
            }
          },
          "expect": "ok"
        },
        {
          "input": {
            "node": "node-3",
            "method": "Application.Get",
            "values": {
              "key": "x"
            }
          },
          "expect": "ok"
        },
        {
          "check": {
            "node": "node-3",
            "path": "lastGet.item.value",
            "op": "==",
            "value": "1"
          }
        },
        {
          "fault": {
            "kind": "recover",
            "node": "node-5"
          }
        },
        {
          "wait": 2000
        },
        {
          "input": {
            "node": "node-5",
            "method": "Application.Get",
            "values": {
              "key": "x"
            }
          },
          "expect": "ok"
        },
        {
          "check": {
            "node": "node-5",
            "path": "lastGet.item.value",
            "op": "==",
            "value": "1"
          }
        }
      ]
    },
    {
      "id": "partition",
      "name": "Quorum partition: minority unavailable",
      "settings": {
        "nodeCount": 5,
        "latency": 80
      },
      "steps": [
        {
          "fault": {
            "kind": "link",
            "from": "node-1",
            "to": "node-3",
            "blocked": true,
            "bidirectional": true
          }
        },
        {
          "fault": {
            "kind": "link",
            "from": "node-1",
            "to": "node-4",
            "blocked": true,
            "bidirectional": true
          }
        },
        {
          "fault": {
            "kind": "link",
            "from": "node-1",
            "to": "node-5",
            "blocked": true,
            "bidirectional": true
          }
        },
        {
          "fault": {
            "kind": "link",
            "from": "node-2",
            "to": "node-3",
            "blocked": true,
            "bidirectional": true
          }
        },
        {
          "fault": {
            "kind": "link",
            "from": "node-2",
            "to": "node-4",
            "blocked": true,
            "bidirectional": true
          }
        },
        {
          "fault": {
            "kind": "link",
            "from": "node-2",
            "to": "node-5",
            "blocked": true,
            "bidirectional": true
          }
        },
        {
          "input": {
            "node": "node-1",
            "method": "Application.Put",
            "values": {
              "key": "minority",
              "value": "no"
            }
          },
          "expect": "error"
        },
        {
          "input": {
            "node": "node-3",
            "method": "Application.Put",
            "values": {
              "key": "x",
              "value": "majority"
            }
          },
          "expect": "ok"
        },
        {
          "input": {
            "node": "node-4",
            "method": "Application.Get",
            "values": {
              "key": "x"
            }
          },
          "expect": "ok"
        },
        {
          "check": {
            "node": "node-4",
            "path": "lastGet.item.value",
            "op": "==",
            "value": "majority"
          }
        },
        {
          "fault": {
            "kind": "heal"
          }
        },
        {
          "input": {
            "node": "node-1",
            "method": "Application.Get",
            "values": {
              "key": "x"
            }
          },
          "expect": "ok"
        },
        {
          "check": {
            "node": "node-1",
            "path": "lastGet.item.value",
            "op": "==",
            "value": "majority"
          }
        }
      ]
    },
    {
      "id": "variant-nonintersection",
      "name": "Quorum variant: W=R=1 stale read",
      "settings": {
        "nodeCount": 5,
        "latency": 80
      },
      "steps": [
        {
          "input": {
            "node": "node-1",
            "method": "Application.Mode",
            "values": {
              "w": 1,
              "r": 1
            }
          },
          "expect": "ok"
        },
        {
          "input": {
            "node": "node-2",
            "method": "Application.Mode",
            "values": {
              "w": 1,
              "r": 1
            }
          },
          "expect": "ok"
        },
        {
          "input": {
            "node": "node-3",
            "method": "Application.Mode",
            "values": {
              "w": 1,
              "r": 1
            }
          },
          "expect": "ok"
        },
        {
          "input": {
            "node": "node-4",
            "method": "Application.Mode",
            "values": {
              "w": 1,
              "r": 1
            }
          },
          "expect": "ok"
        },
        {
          "input": {
            "node": "node-5",
            "method": "Application.Mode",
            "values": {
              "w": 1,
              "r": 1
            }
          },
          "expect": "ok"
        },
        {
          "fault": {
            "kind": "link",
            "from": "node-1",
            "to": "node-2",
            "blocked": true,
            "bidirectional": true
          }
        },
        {
          "fault": {
            "kind": "link",
            "from": "node-1",
            "to": "node-3",
            "blocked": true,
            "bidirectional": true
          }
        },
        {
          "fault": {
            "kind": "link",
            "from": "node-1",
            "to": "node-4",
            "blocked": true,
            "bidirectional": true
          }
        },
        {
          "fault": {
            "kind": "link",
            "from": "node-1",
            "to": "node-5",
            "blocked": true,
            "bidirectional": true
          }
        },
        {
          "input": {
            "node": "node-1",
            "method": "Application.Put",
            "values": {
              "key": "x",
              "value": "1"
            }
          },
          "expect": "ok"
        },
        {
          "input": {
            "node": "node-3",
            "method": "Application.Get",
            "values": {
              "key": "x",
              "minCounter": 1
            }
          },
          "expect": "ok"
        },
        {
          "check": {
            "node": "node-3",
            "path": "lastGet.stale",
            "op": "==",
            "value": true
          }
        },
        {
          "check": {
            "node": "node-3",
            "path": "lastGet.item.version.counter",
            "op": "==",
            "value": 0
          }
        }
      ]
    }
  ]
}
