{
  "scenarios": [
    {
      "id": "normal-six-events",
      "name": "Clocks normal: lecture six events",
      "settings": {
        "nodeCount": 3,
        "latency": 80
      },
      "steps": [
        {
          "input": {
            "node": "node-1",
            "method": "Application.Local",
            "values": {
              "label": "a"
            }
          },
          "expect": "ok"
        },
        {
          "input": {
            "node": "node-3",
            "method": "Application.Local",
            "values": {
              "label": "e"
            }
          },
          "expect": "ok"
        },
        {
          "input": {
            "node": "node-1",
            "method": "Application.Send",
            "values": {
              "to": "node-2",
              "label": "b",
              "receiveLabel": "c"
            }
          },
          "expect": "ok"
        },
        {
          "input": {
            "node": "node-2",
            "method": "Application.Send",
            "values": {
              "to": "node-3",
              "label": "d",
              "receiveLabel": "f"
            }
          },
          "expect": "ok"
        },
        {
          "check": {
            "node": "node-1",
            "path": "events.0.timestamp",
            "op": "==",
            "value": {
              "lamport": 1,
              "vector": [
                1,
                0,
                0
              ],
              "total": 3
            }
          }
        },
        {
          "check": {
            "node": "node-1",
            "path": "events.1.timestamp",
            "op": "==",
            "value": {
              "lamport": 2,
              "vector": [
                2,
                0,
                0
              ],
              "total": 6
            }
          }
        },
        {
          "check": {
            "node": "node-2",
            "path": "events.0.timestamp",
            "op": "==",
            "value": {
              "lamport": 3,
              "vector": [
                2,
                1,
                0
              ],
              "total": 10
            }
          }
        },
        {
          "check": {
            "node": "node-2",
            "path": "events.1.timestamp",
            "op": "==",
            "value": {
              "lamport": 4,
              "vector": [
                2,
                2,
                0
              ],
              "total": 13
            }
          }
        },
        {
          "check": {
            "node": "node-3",
            "path": "events.0.timestamp",
            "op": "==",
            "value": {
              "lamport": 1,
              "vector": [
                0,
                0,
                1
              ],
              "total": 5
            }
          }
        },
        {
          "check": {
            "node": "node-3",
            "path": "events.1.timestamp",
            "op": "==",
            "value": {
              "lamport": 5,
              "vector": [
                2,
                2,
                2
              ],
              "total": 17
            }
          }
        },
        {
          "input": {
            "node": "node-1",
            "method": "Application.CompareEvents",
            "values": {
              "left": {
                "$state": {
                  "node": "node-1",
                  "path": "events.1.timestamp"
                }
              },
              "right": {
                "$state": {
                  "node": "node-3",
                  "path": "events.0.timestamp"
                }
              }
            }
          },
          "expect": "ok"
        },
        {
          "check": {
            "node": "node-1",
            "path": "lastCompare.vector",
            "op": "==",
            "value": "concurrent"
          }
        },
        {
          "check": {
            "node": "node-1",
            "path": "lastCompare.agrees",
            "op": "==",
            "value": true
          }
        },
        {
          "check": {
            "node": "node-1",
            "path": "lastCompare.lamport",
            "op": "==",
            "value": "a>b"
          }
        },
        {
          "input": {
            "node": "node-1",
            "method": "Application.CompareEvents",
            "values": {
              "left": {
                "$state": {
                  "node": "node-1",
                  "path": "events.1.timestamp"
                }
              },
              "right": {
                "$state": {
                  "node": "node-3",
                  "path": "events.1.timestamp"
                }
              }
            }
          },
          "expect": "ok"
        },
        {
          "check": {
            "node": "node-1",
            "path": "lastCompare.vector",
            "op": "==",
            "value": "happens-before"
          }
        },
        {
          "check": {
            "node": "node-1",
            "path": "lastCompare.agrees",
            "op": "==",
            "value": true
          }
        }
      ]
    },
    {
      "id": "equal-concurrent",
      "name": "Clocks: equal Lamport concurrent events",
      "settings": {
        "nodeCount": 3,
        "latency": 80
      },
      "steps": [
        {
          "concurrent": [
            {
              "node": "node-1",
              "method": "Application.Local",
              "values": {
                "label": "first"
              }
            },
            {
              "node": "node-2",
              "method": "Application.Local",
              "values": {
                "label": "first"
              }
            },
            {
              "node": "node-3",
              "method": "Application.Local",
              "values": {
                "label": "first"
              }
            }
          ],
          "expect": "ok"
        },
        {
          "check": {
            "node": "*",
            "path": "clock.lamport",
            "op": "==",
            "value": 1
          }
        },
        {
          "input": {
            "node": "node-1",
            "method": "Application.CompareEvents",
            "values": {
              "left": {
                "$state": {
                  "node": "node-1",
                  "path": "events.0.timestamp"
                }
              },
              "right": {
                "$state": {
                  "node": "node-2",
                  "path": "events.0.timestamp"
                }
              }
            }
          },
          "expect": "ok"
        },
        {
          "check": {
            "node": "node-1",
            "path": "lastCompare.vector",
            "op": "==",
            "value": "concurrent"
          }
        },
        {
          "check": {
            "node": "node-1",
            "path": "lastCompare.agrees",
            "op": "==",
            "value": true
          }
        },
        {
          "check": {
            "node": "node-1",
            "path": "lastCompare.lamport",
            "op": "==",
            "value": "equal"
          }
        },
        {
          "input": {
            "node": "node-1",
            "method": "Application.CompareEvents",
            "values": {
              "left": {
                "$state": {
                  "node": "node-1",
                  "path": "events.0.timestamp"
                }
              },
              "right": {
                "$state": {
                  "node": "node-3",
                  "path": "events.0.timestamp"
                }
              }
            }
          },
          "expect": "ok"
        },
        {
          "check": {
            "node": "node-1",
            "path": "lastCompare.vector",
            "op": "==",
            "value": "concurrent"
          }
        },
        {
          "check": {
            "node": "node-1",
            "path": "lastCompare.agrees",
            "op": "==",
            "value": true
          }
        },
        {
          "check": {
            "node": "node-1",
            "path": "lastCompare.lamport",
            "op": "==",
            "value": "equal"
          }
        },
        {
          "input": {
            "node": "node-1",
            "method": "Application.CompareEvents",
            "values": {
              "left": {
                "$state": {
                  "node": "node-2",
                  "path": "events.0.timestamp"
                }
              },
              "right": {
                "$state": {
                  "node": "node-3",
                  "path": "events.0.timestamp"
                }
              }
            }
          },
          "expect": "ok"
        },
        {
          "check": {
            "node": "node-1",
            "path": "lastCompare.vector",
            "op": "==",
            "value": "concurrent"
          }
        },
        {
          "check": {
            "node": "node-1",
            "path": "lastCompare.agrees",
            "op": "==",
            "value": true
          }
        },
        {
          "check": {
            "node": "node-1",
            "path": "lastCompare.lamport",
            "op": "==",
            "value": "equal"
          }
        }
      ]
    },
    {
      "id": "auto-invariant",
      "name": "Clocks: automatic random events",
      "settings": {
        "nodeCount": 3,
        "latency": 80
      },
      "steps": [
        {
          "concurrent": [
            {
              "node": "node-1",
              "method": "Application.Auto",
              "values": {
                "count": 6
              }
            },
            {
              "node": "node-2",
              "method": "Application.Auto",
              "values": {
                "count": 6
              }
            },
            {
              "node": "node-3",
              "method": "Application.Auto",
              "values": {
                "count": 6
              }
            }
          ],
          "expect": "ok"
        },
        {
          "until": {
            "node": "*",
            "path": "autoRunning",
            "op": "==",
            "value": false
          },
          "timeout": 30000
        },
        {
          "input": {
            "node": "node-1",
            "method": "Application.Read",
            "values": {}
          },
          "expect": "ok"
        },
        {
          "input": {
            "node": "node-2",
            "method": "Application.Read",
            "values": {}
          },
          "expect": "ok"
        },
        {
          "input": {
            "node": "node-3",
            "method": "Application.Read",
            "values": {}
          },
          "expect": "ok"
        },
        {
          "input": {
            "node": "node-1",
            "method": "Application.CompareEvents",
            "values": {
              "left": {
                "$state": {
                  "node": "node-1",
                  "path": "events.0.timestamp"
                }
              },
              "right": {
                "$state": {
                  "node": "node-2",
                  "path": "clock"
                }
              }
            }
          },
          "expect": "ok"
        },
        {
          "check": {
            "node": "node-1",
            "path": "lastCompare.agrees",
            "op": "==",
            "value": true
          }
        },
        {
          "input": {
            "node": "node-1",
            "method": "Application.CompareEvents",
            "values": {
              "left": {
                "$state": {
                  "node": "node-1",
                  "path": "events.0.timestamp"
                }
              },
              "right": {
                "$state": {
                  "node": "node-3",
                  "path": "clock"
                }
              }
            }
          },
          "expect": "ok"
        },
        {
          "check": {
            "node": "node-1",
            "path": "lastCompare.agrees",
            "op": "==",
            "value": true
          }
        },
        {
          "input": {
            "node": "node-1",
            "method": "Application.CompareEvents",
            "values": {
              "left": {
                "$state": {
                  "node": "node-2",
                  "path": "events.0.timestamp"
                }
              },
              "right": {
                "$state": {
                  "node": "node-3",
                  "path": "clock"
                }
              }
            }
          },
          "expect": "ok"
        },
        {
          "check": {
            "node": "node-1",
            "path": "lastCompare.agrees",
            "op": "==",
            "value": true
          }
        }
      ]
    },
    {
      "id": "crash-recovery",
      "name": "Clocks crash: durable counters",
      "settings": {
        "nodeCount": 3,
        "latency": 80
      },
      "steps": [
        {
          "input": {
            "node": "node-2",
            "method": "Application.Local",
            "values": {
              "label": "before"
            }
          },
          "expect": "ok"
        },
        {
          "fault": {
            "kind": "crash",
            "node": "node-2"
          }
        },
        {
          "input": {
            "node": "node-1",
            "method": "Application.Send",
            "values": {
              "to": "node-2",
              "label": "lost",
              "receiveLabel": "not-received"
            }
          },
          "expect": "ok"
        },
        {
          "check": {
            "node": "node-1",
            "path": "lastDelivery.confirmed",
            "op": "==",
            "value": false
          }
        },
        {
          "fault": {
            "kind": "recover",
            "node": "node-2"
          }
        },
        {
          "wait": 2000
        },
        {
          "input": {
            "node": "node-2",
            "method": "Application.Local",
            "values": {
              "label": "after"
            }
          },
          "expect": "ok"
        },
        {
          "check": {
            "node": "node-2",
            "path": "clock.lamport",
            "op": "==",
            "value": 2
          }
        },
        {
          "input": {
            "node": "node-1",
            "method": "Application.Send",
            "values": {
              "to": "node-2",
              "label": "retry-new-event",
              "receiveLabel": "received"
            }
          },
          "expect": "ok"
        },
        {
          "check": {
            "node": "node-1",
            "path": "lastDelivery.confirmed",
            "op": "==",
            "value": true
          }
        }
      ]
    },
    {
      "id": "partition",
      "name": "Clocks partition: local events continue",
      "settings": {
        "nodeCount": 3,
        "latency": 80
      },
      "steps": [
        {
          "fault": {
            "kind": "link",
            "from": "node-1",
            "to": "node-3",
            "blocked": true,
            "bidirectional": true
          }
        },
        {
          "input": {
            "node": "node-1",
            "method": "Application.Send",
            "values": {
              "to": "node-3",
              "label": "lost",
              "receiveLabel": "absent"
            }
          },
          "expect": "ok"
        },
        {
          "check": {
            "node": "node-1",
            "path": "lastDelivery.confirmed",
            "op": "==",
            "value": false
          }
        },
        {
          "input": {
            "node": "node-3",
            "method": "Application.Local",
            "values": {
              "label": "independent"
            }
          },
          "expect": "ok"
        },
        {
          "fault": {
            "kind": "heal"
          }
        },
        {
          "input": {
            "node": "node-1",
            "method": "Application.Send",
            "values": {
              "to": "node-3",
              "label": "new-send",
              "receiveLabel": "new-receive"
            }
          },
          "expect": "ok"
        },
        {
          "check": {
            "node": "node-1",
            "path": "lastDelivery.confirmed",
            "op": "==",
            "value": true
          }
        }
      ]
    },
    {
      "id": "variant-no-merge",
      "name": "Clocks variant: omit receive merge",
      "settings": {
        "nodeCount": 3,
        "latency": 80
      },
      "steps": [
        {
          "input": {
            "node": "node-2",
            "method": "Application.Variant",
            "values": {
              "omitReceiveMerge": true
            }
          },
          "expect": "ok"
        },
        {
          "input": {
            "node": "node-1",
            "method": "Application.Local",
            "values": {
              "label": "a"
            }
          },
          "expect": "ok"
        },
        {
          "input": {
            "node": "node-1",
            "method": "Application.Send",
            "values": {
              "to": "node-2",
              "label": "b",
              "receiveLabel": "c"
            }
          },
          "expect": "ok"
        },
        {
          "check": {
            "node": "node-2",
            "path": "clock.lamport",
            "op": "==",
            "value": 1
          }
        },
        {
          "input": {
            "node": "node-1",
            "method": "Application.CompareEvents",
            "values": {
              "left": {
                "$state": {
                  "node": "node-1",
                  "path": "events.1.timestamp"
                }
              },
              "right": {
                "$state": {
                  "node": "node-2",
                  "path": "events.0.timestamp"
                }
              }
            }
          },
          "expect": "ok"
        },
        {
          "check": {
            "node": "node-1",
            "path": "lastCompare.vector",
            "op": "==",
            "value": "concurrent"
          }
        },
        {
          "check": {
            "node": "node-1",
            "path": "lastCompare.lamport",
            "op": "==",
            "value": "a>b"
          }
        }
      ]
    }
  ]
}
