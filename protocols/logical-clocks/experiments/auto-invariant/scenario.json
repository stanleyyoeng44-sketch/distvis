{
  "id": "auto-invariant",
  "name": "Clocks: automatic random events",
  "settings": {
    "nodeCount": 3,
    "latency": 80
  },
  "steps": [
    {
      "concurrent": [
        {
          "node": "node-1",
          "method": "Application.Auto",
          "values": {
            "count": 6
          }
        },
        {
          "node": "node-2",
          "method": "Application.Auto",
          "values": {
            "count": 6
          }
        },
        {
          "node": "node-3",
          "method": "Application.Auto",
          "values": {
            "count": 6
          }
        }
      ],
      "expect": "ok"
    },
    {
      "until": {
        "node": "*",
        "path": "autoRunning",
        "op": "==",
        "value": false
      },
      "timeout": 30000
    },
    {
      "input": {
        "node": "node-1",
        "method": "Application.Read",
        "values": {}
      },
      "expect": "ok"
    },
    {
      "input": {
        "node": "node-2",
        "method": "Application.Read",
        "values": {}
      },
      "expect": "ok"
    },
    {
      "input": {
        "node": "node-3",
        "method": "Application.Read",
        "values": {}
      },
      "expect": "ok"
    },
    {
      "input": {
        "node": "node-1",
        "method": "Application.CompareEvents",
        "values": {
          "left": {
            "$state": {
              "node": "node-1",
              "path": "events.0.timestamp"
            }
          },
          "right": {
            "$state": {
              "node": "node-2",
              "path": "clock"
            }
          }
        }
      },
      "expect": "ok"
    },
    {
      "check": {
        "node": "node-1",
        "path": "lastCompare.agrees",
        "op": "==",
        "value": true
      }
    },
    {
      "input": {
        "node": "node-1",
        "method": "Application.CompareEvents",
        "values": {
          "left": {
            "$state": {
              "node": "node-1",
              "path": "events.0.timestamp"
            }
          },
          "right": {
            "$state": {
              "node": "node-3",
              "path": "clock"
            }
          }
        }
      },
      "expect": "ok"
    },
    {
      "check": {
        "node": "node-1",
        "path": "lastCompare.agrees",
        "op": "==",
        "value": true
      }
    },
    {
      "input": {
        "node": "node-1",
        "method": "Application.CompareEvents",
        "values": {
          "left": {
            "$state": {
              "node": "node-2",
              "path": "events.0.timestamp"
            }
          },
          "right": {
            "$state": {
              "node": "node-3",
              "path": "clock"
            }
          }
        }
      },
      "expect": "ok"
    },
    {
      "check": {
        "node": "node-1",
        "path": "lastCompare.agrees",
        "op": "==",
        "value": true
      }
    }
  ]
}
