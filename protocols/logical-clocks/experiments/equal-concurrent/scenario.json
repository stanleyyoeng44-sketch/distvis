{
  "id": "equal-concurrent",
  "name": "Clocks: equal Lamport concurrent events",
  "settings": {
    "nodeCount": 3,
    "latency": 80
  },
  "steps": [
    {
      "concurrent": [
        {
          "node": "node-1",
          "method": "Application.Local",
          "values": {
            "label": "first"
          }
        },
        {
          "node": "node-2",
          "method": "Application.Local",
          "values": {
            "label": "first"
          }
        },
        {
          "node": "node-3",
          "method": "Application.Local",
          "values": {
            "label": "first"
          }
        }
      ],
      "expect": "ok"
    },
    {
      "check": {
        "node": "*",
        "path": "clock.lamport",
        "op": "==",
        "value": 1
      }
    },
    {
      "input": {
        "node": "node-1",
        "method": "Application.CompareEvents",
        "values": {
          "left": {
            "$state": {
              "node": "node-1",
              "path": "events.0.timestamp"
            }
          },
          "right": {
            "$state": {
              "node": "node-2",
              "path": "events.0.timestamp"
            }
          }
        }
      },
      "expect": "ok"
    },
    {
      "check": {
        "node": "node-1",
        "path": "lastCompare.vector",
        "op": "==",
        "value": "concurrent"
      }
    },
    {
      "check": {
        "node": "node-1",
        "path": "lastCompare.agrees",
        "op": "==",
        "value": true
      }
    },
    {
      "check": {
        "node": "node-1",
        "path": "lastCompare.lamport",
        "op": "==",
        "value": "equal"
      }
    },
    {
      "input": {
        "node": "node-1",
        "method": "Application.CompareEvents",
        "values": {
          "left": {
            "$state": {
              "node": "node-1",
              "path": "events.0.timestamp"
            }
          },
          "right": {
            "$state": {
              "node": "node-3",
              "path": "events.0.timestamp"
            }
          }
        }
      },
      "expect": "ok"
    },
    {
      "check": {
        "node": "node-1",
        "path": "lastCompare.vector",
        "op": "==",
        "value": "concurrent"
      }
    },
    {
      "check": {
        "node": "node-1",
        "path": "lastCompare.agrees",
        "op": "==",
        "value": true
      }
    },
    {
      "check": {
        "node": "node-1",
        "path": "lastCompare.lamport",
        "op": "==",
        "value": "equal"
      }
    },
    {
      "input": {
        "node": "node-1",
        "method": "Application.CompareEvents",
        "values": {
          "left": {
            "$state": {
              "node": "node-2",
              "path": "events.0.timestamp"
            }
          },
          "right": {
            "$state": {
              "node": "node-3",
              "path": "events.0.timestamp"
            }
          }
        }
      },
      "expect": "ok"
    },
    {
      "check": {
        "node": "node-1",
        "path": "lastCompare.vector",
        "op": "==",
        "value": "concurrent"
      }
    },
    {
      "check": {
        "node": "node-1",
        "path": "lastCompare.agrees",
        "op": "==",
        "value": true
      }
    },
    {
      "check": {
        "node": "node-1",
        "path": "lastCompare.lamport",
        "op": "==",
        "value": "equal"
      }
    }
  ]
}
